# MongoDB Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/sankalp?retryWrites=true&w=majority
DATABASE_NAME=sankalp

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Application
APP_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# File uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Attendance settings
CONFIDENCE_THRESHOLD=70
LATE_AFTER_TIME=09:00
WORK_START_TIME=08:00

# Admin seed (for initial setup)
ADMIN_EMAIL=admin@sankalp.gov.in
ADMIN_PASSWORD=Admin@1234
ADMIN_NAME=System Administrator
